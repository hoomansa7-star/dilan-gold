# ==============================================================
# Dilan Gold ERP - Environment Configuration (تنظیمات سامانه دیلان)
# ==============================================================

# Supabase PostgreSQL Connection String (آدرس اتصال دیتابیس ابری سوپابیس)
# نمونه فرمت اتصال از سوپابیس (پورت 5432 برای اتصال مستقیم یا 6543 برای Pooler):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# اگر این متغیر خالی بماند، برنامه به صورت خودکار از دیتابیس محلی SQLite استفاده خواهد کرد.
DATABASE_URL=

# Port for local or cloud deployment (پورت اجرای برنامه)
PORT=8000
